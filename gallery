  <script>
    /* 최초 설치 때 Apps Script의 /exec 주소를 한 번만 입력하세요. 이후 작품은 스프레드시트에서 관리합니다. */
    const GALLERY_API_URL='https://script.google.com/macros/s/AKfycbzjEduJAHZARryjLymCowTp0G4MEHTO1c8K_twDF241bE1rHPKCBl9ISeWcXS-45L4vgw/exec';
    const ethicsValues=['🔎 검증','⚖️ 공정','🧠 판단','🤝 존중','🔒 보호','🛡️ 책임'];
    const filmGrid=document.querySelector('#filmGrid'),viewProgress=document.querySelector('#viewProgress'),heroFilmCount=document.querySelector('#heroFilmCount'),valueOptions=document.querySelector('#valueOptions'),selectedValue=document.querySelector('#selectedValue'),promiseText=document.querySelector('#promiseText'),charCount=document.querySelector('#charCount'),promiseForm=document.querySelector('#promiseForm'),submitPromise=document.querySelector('#submitPromise'),promiseNotice=document.querySelector('#promiseNotice'),promiseGrid=document.querySelector('#promiseGrid'),wallCount=document.querySelector('#wallCount'),heroPromiseCount=document.querySelector('#heroPromiseCount');
    const viewed=new Set(JSON.parse(localStorage.getItem('cleanerViewedFilms')||'[]'));
    let films=[];

    function escapeHtml(value){return String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
    function safeHttpUrl(value){try{const url=new URL(value);return url.protocol==='https:'?url.href:''}catch(error){return''}}
    function youtubeId(url){const patterns=[/[?&]v=([^&#]+)/,/youtu\.be\/([^?&#/]+)/,/youtube(?:-nocookie)?\.com\/(?:embed|shorts)\/([^?&#/]+)/];for(const pattern of patterns){const match=url.match(pattern);if(match)return match[1]}return''}
    function driveId(url){const patterns=[/drive\.google\.com\/file\/d\/([^/?#]+)/,/drive\.google\.com\/(?:open|uc).*?[?&]id=([^&#]+)/];for(const pattern of patterns){const match=url.match(pattern);if(match)return match[1]}return''}
    function directVideo(url){return /\.(mp4|webm|ogg)(?:[?#].*)?$/i.test(url)}
    function playerMarkup(film,index){const url=safeHttpUrl(film.videoUrl),yt=youtubeId(url),drive=driveId(url),title=escapeHtml(film.title);if(yt)return`<iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(yt)}?rel=0" title="${title}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;if(drive)return`<iframe src="https://drive.google.com/file/d/${encodeURIComponent(drive)}/preview" title="${title}" loading="lazy" allow="autoplay" allowfullscreen></iframe>`;if(directVideo(url))return`<video src="${escapeHtml(url)}" title="${title}" controls preload="metadata" style="position:absolute;inset:0;width:100%;height:100%;z-index:2;background:#000"></video>`;return`<div class="screen-placeholder"><div class="play-mark">↗</div><b>${String(index+1).padStart(2,'0')}</b><small>외부 영상으로 연결됩니다.</small><br><a class="external-link" href="${escapeHtml(url)}" target="_blank" rel="noopener">영상 보러 가기</a></div>`}
    function renderFilms(){heroFilmCount.textContent=films.length;if(!films.length){filmGrid.innerHTML='<div class="empty">현재 공개된 선정작이 없습니다. 관리 시트에서 작품을 승인하면 자동으로 표시됩니다.</div>';viewProgress.textContent='전시 준비 중';return}filmGrid.innerHTML='';films.forEach((film,index)=>{const key=film.id||film.videoUrl,article=document.createElement('article'),comments=Array.isArray(film.comments)?film.comments:[];article.className='film'+(viewed.has(key)?' seen':'');article.innerHTML=`<div class="screen"><span class="seen-badge">✓ 관람 확인</span>${playerMarkup(film,index)}</div><div class="film-body"><div class="film-meta"><span class="value-chip">${escapeHtml(film.value)}</span><span class="crew">${escapeHtml(film.crew)}</span></div><h3>${escapeHtml(film.title)}</h3><p>${escapeHtml(film.description||'AI 윤리 행동을 담은 15초 챌린지 작품입니다.')}</p>${comments.length?`<div class="peer-notes">${comments.map(comment=>`<div class="peer-note">💬 ${escapeHtml(comment)}</div>`).join('')}</div>`:''}<button class="watch-btn" type="button">${viewed.has(key)?'✓ 관람 확인 완료':'이 작품 관람 확인'}</button></div>`;article.querySelector('.watch-btn').onclick=()=>markViewed(key);const external=article.querySelector('.external-link');if(external)external.addEventListener('click',()=>markViewed(key));filmGrid.appendChild(article)});updateViewProgress()}
    function markViewed(key){viewed.add(key);localStorage.setItem('cleanerViewedFilms',JSON.stringify([...viewed]));renderFilms()}
    function updateViewProgress(){const activeIds=new Set(films.map(film=>film.id||film.videoUrl)),count=[...viewed].filter(id=>activeIds.has(id)).length;viewProgress.textContent=`관람 확인 ${count} / ${films.length}`}
    async function loadFilms(){if(!GALLERY_API_URL){filmGrid.innerHTML='<div class="empty">전시관 서버 연결 전입니다. Apps Script /exec 주소를 GALLERY_API_URL에 한 번 입력해 주세요.</div>';viewProgress.textContent='서버 연결 필요';return}try{const response=await fetch(`${GALLERY_API_URL}?action=films`,{redirect:'follow'}),data=await response.json();if(!data.ok)throw new Error(data.error||'작품을 불러오지 못했습니다.');films=data.films||[];renderFilms()}catch(error){filmGrid.innerHTML=`<div class="empty">전시 작품을 불러오지 못했습니다.<br>${escapeHtml(error.message)}</div>`;viewProgress.textContent='연결 오류'}}
    function renderValueOptions(){valueOptions.innerHTML='';ethicsValues.forEach(value=>{const button=document.createElement('button');button.type='button';button.className='value-btn';button.textContent=value;button.onclick=()=>{document.querySelectorAll('.value-btn').forEach(item=>item.classList.remove('selected'));button.classList.add('selected');selectedValue.value=value};valueOptions.appendChild(button)})}
    function showNotice(message,type){promiseNotice.textContent=message;promiseNotice.className=`notice show ${type}`}
    function renderPromises(items){wallCount.textContent=items.length;heroPromiseCount.textContent=items.length;if(!items.length){promiseGrid.innerHTML='<div class="empty">아직 공개된 약속이 없습니다. 첫 번째 CLEANER 약속을 남겨주세요.</div>';return}promiseGrid.innerHTML=items.map(item=>`<article class="promise"><div class="promise-head"><span>${escapeHtml(item.value)}</span><span>${escapeHtml(item.audience)}</span></div><blockquote>“나는 AI를 사용할 때, ${escapeHtml(item.promise)}”</blockquote></article>`).join('')}
    async function loadPromises(){if(!GALLERY_API_URL){promiseGrid.innerHTML='<div class="empty">전시관 서버를 연결하면 승인된 약속이 여기에 표시됩니다.</div>';return}try{const response=await fetch(`${GALLERY_API_URL}?action=promises`,{redirect:'follow'}),data=await response.json();if(!data.ok)throw new Error(data.error||'약속을 불러오지 못했습니다.');renderPromises(data.promises||[])}catch(error){promiseGrid.innerHTML='<div class="empty">약속의 벽을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.</div>'}}
    promiseText.addEventListener('input',()=>charCount.textContent=promiseText.value.length);
    promiseForm.addEventListener('submit',async event=>{event.preventDefault();if(!GALLERY_API_URL){showNotice('전시관 서버가 아직 연결되지 않았습니다.','error');return}if(!selectedValue.value){showNotice('실천할 AI 윤리 가치를 하나 선택해 주세요.','error');return}if(promiseText.value.trim().length<8){showNotice('실천할 행동을 조금 더 구체적으로 적어주세요.','error');return}const item={audience:document.querySelector('#audience').value,value:selectedValue.value,promise:promiseText.value.trim()};submitPromise.disabled=true;submitPromise.textContent='약속을 등록하는 중…';try{const response=await fetch(GALLERY_API_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=UTF-8'},body:JSON.stringify(item),redirect:'follow'}),data=await response.json();if(!data.ok)throw new Error(data.error||'등록하지 못했습니다.');showNotice('약속이 등록되었습니다. 교사 확인 후 약속의 벽에 공개됩니다.','ok');promiseForm.reset();selectedValue.value='';document.querySelectorAll('.value-btn').forEach(button=>button.classList.remove('selected'));charCount.textContent='0'}catch(error){showNotice(`약속을 등록하지 못했습니다. ${error.message}`,'error')}finally{submitPromise.disabled=false;submitPromise.textContent='CLEANER 약속 등록하기'}});
    renderValueOptions();loadFilms();loadPromises();
  </script>
</body>
</html>
